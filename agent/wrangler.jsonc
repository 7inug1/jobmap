{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "app",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "traces": { "enabled": true } },
	// Keyless `cloudflare/...` models run through this Workers AI binding.
	// It reaches your Cloudflare account even in local dev:
	// https://flueframework.com/docs/guide/models/#cloudflare-workers-ai-cloudflare-only
	"ai": { "binding": "AI" },
	// 화면(web/dist)을 같은 Worker에서 내보낸다. 에이전트와 API만 Worker 코드로 보낸다.
	"assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/agents/*", "/api/*"] },
	// Every agent generates a Durable Object class named after its identity
	// (Jobmap -> FlueJobmapAgent), and Cloudflare requires a migration entry
	// for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	// 서비스 전체 하루 총량을 세는 Durable Object (src/cloudflare.ts). 결제 후 비용 상한을 둔다.
	"durable_objects": { "bindings": [{ "name": "DAILY_USAGE", "class_name": "DailyUsage" }] },
	"vars": { "DAILY_COMPARE_LIMIT": 50, "DAILY_DIRECTIONS_LIMIT": 80 },
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueJobmapAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["DailyUsage"] }
	]
}
